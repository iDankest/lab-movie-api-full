{
  "info": {
    "name": "API Películas — Semana 7",
    "description": "Colección de Postman para la API de Películas del Lab Semana 7",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/registro",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Admin\",\n  \"email\": \"admin@cine.com\",\n  \"password\": \"admin123\",\n  \"rol\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "registro"]
            },
            "description": "Registra un nuevo usuario en el sistema"
          }
        },
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cine.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Inicia sesión y devuelve un token JWT"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/perfil",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/perfil",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "perfil"]
            },
            "description": "Obtiene el perfil del usuario autenticado"
          }
        }
      ]
    },
    {
      "name": "Películas",
      "item": [
        {
          "name": "GET /api/peliculas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/peliculas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas"]
            },
            "description": "Lista todas las películas con paginación. Soporta filtros: ?genero=drama&pagina=1&limite=10"
          }
        },
        {
          "name": "GET /api/peliculas?genero=drama",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/peliculas?genero=drama",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas"],
              "query": [
                { "key": "genero", "value": "drama" }
              ]
            },
            "description": "Filtra películas por género"
          }
        },
        {
          "name": "GET /api/peliculas/:id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/peliculas/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas", "1"]
            },
            "description": "Obtiene una película por ID, incluyendo reseñas y conteo de favoritos"
          }
        },
        {
          "name": "POST /api/peliculas",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Dune: Part Two\",\n  \"anio\": 2024,\n  \"nota\": 8.5,\n  \"director\": \"Denis Villeneuve\",\n  \"generoSlug\": \"ciencia-ficcion\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/peliculas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas"]
            },
            "description": "Crea una nueva película (requiere autenticación)"
          }
        },
        {
          "name": "PUT /api/peliculas/:id",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Dune: Part Two (Updated)\",\n  \"nota\": 9.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/peliculas/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas", "1"]
            },
            "description": "Actualiza una película (requiere rol admin)"
          }
        },
        {
          "name": "DELETE /api/peliculas/:id",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/peliculas/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas", "1"]
            },
            "description": "Elimina una película (requiere rol admin)"
          }
        },
        {
          "name": "GET /api/peliculas/:id/resenas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/peliculas/1/resenas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas", "1", "resenas"]
            },
            "description": "Obtiene todas las reseñas de una película"
          }
        },
        {
          "name": "POST /api/peliculas/:id/resenas",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Excelente película, muy recomendada\",\n  \"puntuacion\": 9\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/peliculas/1/resenas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas", "1", "resenas"]
            },
            "description": "Crea una reseña para una película (requiere autenticación)"
          }
        }
      ]
    },
    {
      "name": "Favoritos",
      "item": [
        {
          "name": "GET /api/favoritos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/favoritos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "favoritos"]
            },
            "description": "Lista los favoritos del usuario autenticado"
          }
        },
        {
          "name": "POST /api/favoritos/1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/favoritos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "favoritos", "1"]
            },
            "description": "Añade una película a favoritos"
          }
        },
        {
          "name": "DELETE /api/favoritos/1",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/favoritos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "favoritos", "1"]
            },
            "description": "Elimina una película de favoritos"
          }
        }
      ]
    },
    {
      "name": "Estadísticas",
      "item": [
        {
          "name": "GET /api/estadisticas/directores",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/estadisticas/directores",
              "host": ["{{baseUrl}}"],
              "path": ["api", "estadisticas", "directores"]
            },
            "description": "Estadísticas de películas por director"
          }
        },
        {
          "name": "GET /api/estadisticas/generos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/estadisticas/generos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "estadisticas", "generos"]
            },
            "description": "Estadísticas de películas por género"
          }
        }
      ]
    },
    {
      "name": "IA",
      "item": [
        {
          "name": "POST /api/ia/recomendar",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"generos\": [\"ciencia-ficcion\", \"drama\"],\n  \"nota_minima\": 7.5,\n  \"excluir_ids\": [1, 3],\n  \"limite\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ia/recomendar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ia", "recomendar"]
            },
            "description": "Endpoint para IA - devuelve recomendaciones en formato estructurado"
          }
        }
      ]
    }
  ]
}
